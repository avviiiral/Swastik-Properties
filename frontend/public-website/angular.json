{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "public-website": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "sp",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/public-website",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "ssr": { "entry": "server.ts" },
            "outputMode": "server",
            "tsConfig": "tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": ["src/styles.css"],
            "budgets": [
              { "type": "initial", "maximumWarning": "1mb", "maximumError": "2mb" },
              { "type": "anyComponentStyle", "maximumWarning": "10kb", "maximumError": "16kb" }
            ]
          },
          "configurations": {
            "production": { "optimization": true, "outputHashing": "all", "sourceMap": false },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "public-website:build:production" },
            "development": { "buildTarget": "public-website:build:development" }
          },
          "defaultConfiguration": "development",
          "options": { "proxyConfig": "proxy.conf.json" }
        }
      }
    }
  },
  "cli": { "analytics": false }
}
