# Copy this file to .env and replace the sample credentials.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (create this database and user locally before selecting this URL).
DATABASE_URL=postgres://swastik_user:replace-this-password@localhost:5432/swastik_properties

# Angular development server
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Production HTTPS settings should be configured in the deployment environment.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
